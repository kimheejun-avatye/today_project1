# Local quick start defaults to SQLite. Use PostgreSQL for real multi-request operation.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
# Generate a random 48+ character secret before deployment; do not commit it.
# APP_SECRET=
# DATABASE_URL=postgresql+psycopg://diary:YOUR_PASSWORD@localhost:5432/diary
# Gmail setup: use a sender account and its app password, not its ordinary password.
# MAIL_MODE=smtp
# SMTP_PROVIDER=gmail
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_FROM must match SMTP_USER for the selected Gmail setup.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Google Auth Platform: Web application, authorized origins http://localhost and http://localhost:5173.
# Public client ID only; this JavaScript callback flow does not use a client secret.
# GOOGLE_CLIENT_ID=
# Numeric image CAPTCHA runs on this server; no external CAPTCHA keys needed.
